<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version in the target framework is what brings in the WinRT projection used
         for toast notifications; the app itself still runs on anything the .NET 8 desktop runtime
         supports, and falls back to a notification-area balloon if the toast API is not there. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CodexQuotaChip</RootNamespace>
    <AssemblyName>CodexQuotaChip</AssemblyName>
    <Version>0.2.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 由 tools/make-icon.ps1 生成：深色圆角方块 + 两条额度条 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Codex Quota Chip</Product>
    <Description>A compact taskbar overlay that shows the Codex quota left, plus a right-click panel with every account seen so far.</Description>
    <Authors>easerlee</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 重置次数的票券图标：嵌进程序集，单文件发布也能用 -->
    <Resource Include="Assets\reset-credit.png" />
  </ItemGroup>

</Project>
